# Bhoomisetu — Environment Variables Template
# Copy this file to .env (locally) or configure these in AWS ECS Task Definition / Secrets Manager.
# NEVER commit .env with real values to version control.

# ─── Database ────────────────────────────────────────────────────────────────
# AWS RDS PostgreSQL connection string
DATABASE_URL=postgresql://bhoomisetu_user:CHANGE_ME@your-rds-host.rds.amazonaws.com:5432/bhoomisetu
PG_SSL=true

POSTGRES_USER=bhoomisetu_user
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=bhoomisetu

# ─── JWT & Session Secrets ───────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_min_64_chars
REFRESH_SECRET=CHANGE_ME_min_64_chars

# ─── Encryption Key (Aadhaar / PAN at-rest) ─────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=CHANGE_ME_exactly_32_bytes

# ─── S3 / MinIO File Storage ─────────────────────────────────────────────────
S3_ENDPOINT=https://s3.ap-south-1.amazonaws.com
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
S3_BUCKET=bhoomisetu-parcels
S3_REGION=ap-south-1

# ─── MinIO (local docker-compose only) ───────────────────────────────────────
MINIO_ROOT_USER=CHANGE_ME_admin
MINIO_ROOT_PASSWORD=CHANGE_ME_min_12_chars

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ─── App ─────────────────────────────────────────────────────────────────────
NODE_ENV=production
APP_ENV=production
PORT=3000
NEXT_TELEMETRY_DISABLED=1
