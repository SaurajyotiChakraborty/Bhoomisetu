# ==============================================================================
# Bhoomisetu — .gitignore
# Excludes dependencies, builds, caches, secrets, test artifacts, and OS temp files.
# ==============================================================================

# Dependencies & Package Managers
node_modules/
.pnpm-store/
.yarn/
package-lock.json
yarn.lock

# Next.js Build Outputs, Standalone & Bundler Caches
.next/
out/
build/
dist/
.turbo/
.swc/
.cache/

# TypeScript Compiler Cache
*.tsbuildinfo
tsconfig.tsbuildinfo

# SQLite Database Files, WAL, Shared Memory & Backups
data/*.db
data/*.db-*
data/*.sqlite
data/*.sqlite*
*.sqlite
*.sqlite3
*.db
*.db-shm
*.db-wal
*.db-journal
dump.rdb
*.sql
*.dump

# Local File Storage (Keep folder structure with .gitkeep)
storage/uploads/*
!storage/uploads/.gitkeep
storage/temp/*

# Environment Variables, Secrets & Private Keys
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12

# Credentials, Dumps & Sensitive Output
data/seed-credentials.md
*credentials*
docker-compose.override.yml

# Logs & Process IDs
*.log
*.log.*
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.pid
*.pid.lock
*.seed

# Test & Coverage Outputs
coverage/
playwright-report/
test-results/
.playwright/

# OS-Specific Temporary Files & Thumbnails
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

# IDE, Editor Configurations & AI Assistant Files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
.cursor/
.windsurf/
.claude/
.agents/
.antigravity/
.gemini/

# Scratch & Temporary Folders
scratch/
temp/
tmp/
.temp/
*.tmp
*.bak
*.orig
debug/
*.debug

# Markdown Documentation Files
*.md
**/*.md
*.markdown
**/*.markdown

# Office, PDF & Report Documents
*.docx
*.doc
~$*.docx
*.pdf
*.pptx
*.ppt
*.xlsx
*.xls
*.csv
*.txt

# Documentation Directory
docs/

# Media & Recordings (Captured browser sessions & debug clips)
*.webp
*.mp4
*.webm
*.mov
*.avi
